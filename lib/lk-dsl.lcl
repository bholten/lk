;;; lk-dsl.lcl — Layer 2 declarative DSL for lk (DSL v2, props dicts)
;;;
;;; Wraps Layer 1 lk:: procs with declarative syntax:
;;;   - Kind names (column, button, ...) are commands
;;;   - Nesting implies parent-child
;;;   - Props are passed as a single dict: kind id ?props-dict? ?body-block?
;;;
;;; Usage:
;;;   app "My App" #{font "/path/to/font.ttf" font_size 16} {
;;;       view {
;;;           column "main" #{padding 24} {
;;;               label "title" #{text "Hello!"}
;;;           }
;;;       }
;;;   }
;;;
;;; Props dicts are ordinary values: build them in variables, share them
;;; across widgets, compose with [Dict::merge $base $override].
;;; Unknown prop keys are hard errors (see _apply_props).

;;; The Layer 2 DSL: `app`, `view`, `theme`, `translator`, `keybinding`,
;;; `on`, `event_handler`, and one command per widget kind, all exported
;;; into the caller's scope.
;;;
;;; Every widget command shares one shape — `kind id ?props-dict?
;;; ?body-block?` — with the two trailing args disambiguated by value
;;; shape: a dict is props, anything else is the body block.  Known
;;; prop keys: text, focusable, disabled, w, h, padding, gap, align,
;;; justify, hidden, tooltip, split_ratio, split_controlled, grow,
;;; editor, value, tag, present.  `tag` maps to `lk::tag`, `present`
;;; (a 2-element ptype + value list) to `lk::present`, everything else
;;; to `lk::prop`.  Unknown keys and malformed trailing args are hard
;;; errors carrying the widget id.
namespace lk_dsl {

    ;; ---- Module state ----
    var _tree {}
    var _parent_stack ()
    var _ui {}
    var _win {}
    var _view_body {}
    var _cmd_handlers #{}

    ;; ---- Prop schema ----
    ;; Every key a widget props dict may carry.  `tag` and `present` are
    ;; handled specially (lk::tag / lk::present); the rest map to
    ;; lk::prop.  Values are 1 for now; per-kind validation may hang
    ;; richer descriptors here later.
    let _prop_schema #{text 1 focusable 1 disabled 1 w 1 h 1 padding 1 gap 1 align 1 justify 1 hidden 1 tooltip 1 split_ratio 1 split_controlled 1 grow 1 editor 1 value 1 tag 1 present 1}
    let _known_props [String::join [Dict::keys $_prop_schema] ", "]

    ;; ---- Trailing-arg disambiguation ----
    ;; kind id ?props-dict? ?body-block? — both optional, disambiguated
    ;; by shape: a dict value is props, anything else is the body block.
    ;; Strictness (v2): more than two trailing args is an error; with
    ;; two, the first must be a dict and the second must not be; a lone
    ;; numeric arg (e.g. `button "x" 42`) or a stale `-flag` arg is an
    ;; error.  A lone non-dict, non-numeric, non-dash arg is the body
    ;; (blocks are plain strings in Lcl — not distinguishable by type).
    ;; Returns #{props <dict> body <block>}.
    proc _split_args {kind id rest} {
        var props #{}
        var body {}
        let n [len $rest]

        if [> $n 2] {
            error "$kind \"$id\": too many arguments (expected: $kind id ?props-dict? ?body-block?)"
        }

        if [== $n 2] {
            set! props [get $rest 0]
            set! body [get $rest 1]

            if [not [dict? $props]] {
                error "$kind \"$id\": expected a props dict (#{...}) before the body block"
            }

            if [dict? $body] {
                error "$kind \"$id\": body must be a block, got a second dict"
            }
        }

        if [== $n 1] {
            let a [get $rest 0]

            if [dict? $a] {
                set! props $a
            } else {
                ;; number? first: a typed int/float literal (post-lcl
                ;; c6b44be) is not a string, so empty?/String::index
                ;; would error on it before our diagnostic fired.
                if [number? $a] {
                    error "$kind \"$id\": expected a props dict (#{...}) or body block, got '$a'"
                }

                if [not [empty? $a]] {
                    if [== [String::index $a 0] -] {
                        error "$kind \"$id\": '-flag' syntax was removed; use a props dict (#{...})"
                    }
                }

                set! body $a
            }
        }

        return #{props $props body $body}
    }

    ;; ---- Prop application ----
    ;; Walks the props dict.  Unknown keys are hard errors carrying the
    ;; widget id and the known-key list — no silent swallowing.
    proc _apply_props {kind id node props} {
        foreach key [Dict::keys $props] {
            if [not [has? $_prop_schema $key]] {
                error "$kind \"$id\": unknown prop '$key' (known: $_known_props)"
            }

            let val [get $props $key]

            if [== $key tag] {
                lk::tag $_tree $node $val
            } else {
                if [== $key present] {
                    ;; present (ptype value-or-list) — a list of two elements
                    lk::present $_tree $node [get $val 0] [get $val 1]
                } else {
                    lk::prop $_tree $node $key $val
                }
            }
        }
    }

    ;; ---- Node creation ----
    proc _make_node {kind id rest} {
        let parsed [_split_args $kind $id $rest]
        let props [get $parsed props]
        let body [get $parsed body]

        let node [lk::node $_tree $id $kind]

        ;; Append to current parent
        let stack_len [len $_parent_stack]

        if [> $stack_len 0] {
            let parent [get $_parent_stack [- $stack_len 1]]
            lk::append_child $_tree $parent $node
        }

        ;; Apply props
        _apply_props $kind $id $node $props

        ;; If body present, push this node as parent, eval body, pop
        if [not [empty? $body]] {
            set! _parent_stack [List::push $_parent_stack $node]
            eval $body
            set! _parent_stack [List::slice $_parent_stack 0 [- [len $_parent_stack] 1]]
        }

        return $node
    }

    ;;; Vertical stack container.  Children lay out top to bottom;
    ;;; `gap` spaces them, `align` crosses, `justify` distributes, and
    ;;; per-child `grow` weights share leftover height.
    proc column {id *rest} {
        _make_node column $id $rest
    }

    ;;; Horizontal stack container (the row-axis twin of `column`).
    proc row {id *rest} {
        _make_node row $id $rest
    }

    ;;; Text display widget; set the string with the `text` prop.
    proc label {id *rest} {
        _make_node label $id $rest
    }

    ;;; Click target.  Give it `focusable 1` for keyboard focus and a
    ;;; `present` prop to make clicks emit commands via translators.
    proc button {id *rest} {
        _make_node button $id $rest
    }

    ;;; Single-line text input.  Edits emit value_changed events; feed
    ;;; the edited text back in as the `text` prop each frame.
    proc text_input {id *rest} {
        _make_node text_input $id $rest
    }

    ;;; Flexible empty space.  An unsized spacer grows with weight 1;
    ;;; give it `w`/`h` for fixed space or `grow 0` to pin it.
    proc spacer {id *rest} {
        _make_node spacer $id $rest
    }

    ;;; Vertical scroll container: clips children, wheel-scrolls, and
    ;;; shows a scrollbar when content overflows.
    proc scroll {id *rest} {
        _make_node scroll $id $rest
    }

    ;;; Dropdown selector; its `option` children are the choices.  The
    ;;; `value` prop picks the initial selection by option text;
    ;;; selecting emits value_changed with the option text.
    proc dropdown {id *rest} {
        _make_node dropdown $id $rest
    }

    ;;; One dropdown choice; the `text` prop is its label and value.
    proc option {id *rest} {
        _make_node option $id $rest
    }

    ;;; Two panes side by side with a draggable vertical divider.
    ;;; `split_ratio` (per-mille, 0..1000) sets the initial split;
    ;;; `split_controlled 1` makes the app own the ratio (dragging
    ;;; emits value_changed but writes no state).
    proc split_h {id *rest} {
        _make_node split_h $id $rest
    }

    ;;; Two panes stacked with a draggable horizontal divider (the
    ;;; vertical twin of `split_h`).
    proc split_v {id *rest} {
        _make_node split_v $id $rest
    }

    ;;; Multi-line editor widget.  Wire it to a document view with the
    ;;; `editor` prop (an opaque from `lk::editor_new`):
    ;;;
    ;;;   editor "src" #{editor $ed focusable 1}
    proc editor {id *rest} {
        _make_node editor $id $rest
    }

    ;;; Declare theme rules.  The body sees a `rule` command:
    ;;;
    ;;;   rule <kind> ?selector-dict? style-dict
    ;;;
    ;;; kind "*" matches any; one dict arg is the style, two are
    ;;; selector then style.  Selector keys: `tag`, `state` (focused,
    ;;; hovered, disabled); unknown keys error.  Style keys are the
    ;;; `lk::theme_rule` set (bg, fg, border_color, padding, gap,
    ;;; align, justify, font_id, font_size, ...):
    ;;;
    ;;;   theme {
    ;;;       rule button #{tag primary state hovered} #{bg (65 120 210)}
    ;;;   }
    proc theme {body} {
        ;; rule <kind> ?selector-dict? style-dict
        ;; kind "*" matches any.  One dict arg = style; two = selector
        ;; then style.  Selector keys: tag, state (unknown keys error).
        proc rule {kind *rest} {
            var tag {}
            var state {}
            var style #{}
            let n [len $rest]

            if [== $n 1] {
                set! style [get $rest 0]
            } else {
                if [== $n 2] {
                    let sel [get $rest 0]

                    if [not [dict? $sel]] {
                        error "rule $kind: selector must be a dict (#{tag <tag> state <state>})"
                    }

                    foreach k [Dict::keys $sel] {
                        if [== $k tag] {
                            set! tag [get $sel $k]
                        } else {
                            if [== $k state] {
                                set! state [get $sel $k]
                            } else {
                                error "rule $kind: unknown selector key '$k' (known: tag, state)"
                            }
                        }
                    }
                    set! style [get $rest 1]
                } else {
                    error "rule $kind: expected ?selector-dict? style-dict"
                }
            }

            if [not [dict? $style]] {
                error "rule $kind: style must be a dict (#{bg (r g b) ...})"
            }

            lk::theme_rule $_ui $kind $tag $state $style
        }

        eval $body
    }

    ;;; Register a translator: gestures on nodes presenting `ptype`
    ;;; emit `cmd` (handle it with `on`).
    ;;;
    ;;; A dict anywhere in the trailing args is the matcher (DSL v2
    ;;; style): keys `button` (primary|middle|secondary) and `mods`
    ;;; ("ctrl", "ctrl+shift", ...); unknown keys hard-error.  The
    ;;; positional forms are unchanged:
    ;;;   translator pointer_down item Select
    ;;;   translator pointer_down action button DoIt
    ;;;   translator pointer_down #{button middle} action Execute
    ;;; keybinding <keycode> <mods> <cmd_name>
    ;;; keybinding <keycode> <mods> <ptype> <cmd_name>
    proc translator {event_type *rest} {
        var button ""
        var mods ""
        var seen_dict 0
        var pos ()

        foreach a $rest {
            if [dict? $a] {
                if [== $seen_dict 1] {
                    error "translator $event_type: more than one matcher dict"
                }
                set! seen_dict 1

                foreach k [Dict::keys $a] {
                    if [== $k button] {
                        set! button [get $a $k]
                    } else {
                        if [== $k mods] {
                            set! mods [get $a $k]
                        } else {
                            error "translator $event_type: unknown matcher key '$k' (known: button, mods)"
                        }
                    }
                }
            } else {
                set! pos [List::push $pos $a]
            }
        }

        let np [len $pos]

        if [== $np 2] {
            ;; translator event ?matcher? ptype cmd
            lk::add_translator $_ui $event_type [get $pos 0] "" "" $mods [get $pos 1] $button
        } else {
            if [== $np 3] {
                ;; translator event ?matcher? ptype kind cmd
                lk::add_translator $_ui $event_type [get $pos 0] [get $pos 1] "" $mods [get $pos 2] $button
            } else {
                error "translator $event_type: expected ?matcher-dict? ptype ?kind? cmd"
            }
        }
    }

    ;;; Bind a key chord to a command: `keybinding <keycode> <mods>
    ;;; ?<ptype>? <cmd>`.  The 3-arg form is global (any focus); the
    ;;; 4-arg form fires only with a `ptype` presentation under focus.
    ;;; Sugar for a key_down translator:
    ;;;
    ;;;   keybinding g ctrl GotoLine
    proc keybinding {keycode mods *rest} {
        if [== [len $rest] 1] {
            ;; 3-arg form: keybinding key mods cmd (global, no ptype)
            lk::add_translator $_ui "key_down" "" "" $keycode $mods [get $rest 0]
        } else {
            ;; 4-arg form: keybinding key mods ptype cmd
            lk::add_translator $_ui "key_down" [get $rest 0] "" $keycode $mods [get $rest 1]
        }
    }

    ;;; Register a handler for a named command.  The handler receives
    ;;; the command dict (`name`, `args`, `source_value`,
    ;;; `source_node_id`, and `hit` for interior presentations):
    ;;;
    ;;;   on Select [lambda {cmd} { puts [get $cmd args] }]
    proc on {cmd_name handler} {
        set! _cmd_handlers [put $_cmd_handlers $cmd_name $handler]
    }

    ;;; Install an app-level event handler on the window; the callable
    ;;; receives an event dict for every event no widget consumed.
    proc event_handler {callable} {
        lk::window_set_event_handler $_win $callable
    }

    ;;; Declare the view: the body re-runs every frame to rebuild the
    ;;; tree under an implicit root window node.  Keep widget ids
    ;;; stable across frames — retained state and focus follow ids.
    proc view {body} {
        set! _view_body $body
    }

    ;; ---- Internal: dispatch commands ----
    proc _dispatch_command {cmd} {
        let name [get $cmd name]

        if [has? $_cmd_handlers $name] {
            let handler [get $_cmd_handlers $name]
            apply $handler $cmd
        }
    }

    ;; ---- Internal: frame callback ----
    proc _frame {tree} {
        set! _tree $tree
        set! _parent_stack ()

        ;; Create implicit root window node
        let root [lk::node $_tree "root" "window"]
        lk::set_root $_tree $root
        set! _parent_stack [List::push $_parent_stack $root]

        ;; Eval the user's view body
        eval $_view_body

        set! _parent_stack ()
    }

    ;;; Create the window and run the app: `app "Title" ?props-dict?
    ;;; body-block`.
    ;;;
    ;;; Props: `width` and `height` (default 800x600), `font` (a .ttf
    ;;; path) and `font_size` (default 16); unknown keys hard-error.
    ;;; The body runs once to register `theme`, `translator`,
    ;;; `keybinding`, `on`, `view`, and `event_handler`; then the
    ;;; frame loop runs the view body every frame until the window
    ;;; closes, and the window is destroyed on the way out.
    proc app {title *rest} {
        var props #{}
        var body {}
        var width 800
        var height 600
        var font {}
        var font_size 16
        let n [len $rest]

        if [or [< $n 1] [> $n 2]] {
            error "app \"$title\": expected app title ?props-dict? body-block"
        }

        if [== $n 2] {
            set! props [get $rest 0]
            set! body [get $rest 1]

            if [not [dict? $props]] {
                error "app \"$title\": expected a props dict (#{...}) before the body block"
            }
        } else {
            set! body [get $rest 0]
        }

        if [dict? $body] {
            error "app \"$title\": body must be a block, got a dict"
        }

        foreach key [Dict::keys $props] {
            let val [get $props $key]

            if [== $key width] {
                set! width $val
            } else {
                if [== $key height] {
                    set! height $val
                } else {
                    if [== $key font] {
                        set! font $val
                    } else {
                        if [== $key font_size] {
                            set! font_size $val
                        } else {
                            error "app \"$title\": unknown key '$key' (known: width, height, font, font_size)"
                        }
                    }
                }
            }
        }

        ;; Create window and UI
        if [empty? $font] {
            set! _win [lk::window_create $title $width $height]
        } else {
            set! _win [lk::window_create $title $width $height $font $font_size]
        }

        set! _ui [lk::window_ui $_win]

        ;; Eval body — registers theme, translators, on-handlers, view, event_handler
        eval $body

        ;; Install command dispatcher if any on-handlers were registered
        if [not [empty? $_cmd_handlers]] {
            lk::set_command_handler $_ui [lambda {cmd} {
                lk_dsl::_dispatch_command $cmd
            }]
        }

        ;; Run the window loop
        lk::window_run $_win [lambda {tree} { lk_dsl::_frame $tree }]

        ;; Cleanup
        lk::window_destroy $_win
    }
}

;; Export all public DSL procs into caller's scope
import lk_dsl app
import lk_dsl view theme translator keybinding on event_handler
import lk_dsl column row label button text_input spacer scroll
import lk_dsl dropdown option split_h split_v editor
