;; lk-dsl.lcl — Layer 2 declarative DSL for lk
;;
;; Wraps Layer 1 lk:: procs with declarative syntax:
;;   - Kind names (column, button, ...) are commands
;;   - Nesting implies parent-child
;;   - -flag value sets props
;;
;; Usage:
;;   app "My App" -font "/path/to/font.ttf" {
;;       view {
;;           column "main" -padding 24 {
;;               label "title" -text "Hello!"
;;           }
;;       }
;;   }

namespace lk_dsl {

    ;; ---- Module state ----
    var _tree {}
    var _parent_stack ()
    var _ui {}
    var _win {}
    var _view_body {}
    var _cmd_handlers #{}

    ;; ---- Flag parsing ----
    ;; Walks args list for -key value pairs. Last non-flag arg is the body.
    ;; Returns #{id <id> flags <dict> body <block>}
    proc _parse_flags {id args} {
        var flags #{}
        var body {}
        var i 0
        let n [len $args]

        while [< $i $n] {
            let arg [get $args $i]

            if [== [String::index $arg 0] -] {
                ;; Flag: strip the leading - and take next arg as value
                let key [String::range $arg 1 [len $arg]]

                if [< [+ $i 1] $n] {
                    set! flags [put $flags $key [get $args [+ $i 1]]]
                    set! i [+ $i 2]
                } else {
                    ;; Trailing flag with no value — treat as boolean true
                    set! flags [put $flags $key 1]
                    set! i [+ $i 1]
                }
            } else {
                if [== $i [- $n 1]] {
                    ;; Last non-flag arg is the body block
                    set! body $arg
                } else {
                    ;; Unexpected positional arg — ignore
                }
                set! i [+ $i 1]
            }
        }

        return #{id $id flags $flags body $body}
    }

    ;; ---- Prop application ----
    ;; Known prop keys that map to lk::prop
    let _prop_keys #{text 1 focusable 1 disabled 1 w 1 h 1 padding 1 gap 1 align 1 justify 1}

    proc _apply_flags {node flags} {
        foreach key [Dict::keys $flags] {
            let val [get $flags $key]

            if [== $key tag] {
                lk::tag $_tree $node $val
            } else {
                if [== $key present] {
                    ;; -present (ptype value) — a list of two elements
                    lk::present $_tree $node [get $val 0] [get $val 1]
                } else {
                    if [has? $_prop_keys $key] {
                        lk::prop $_tree $node $key $val
                    }
                    ;; Unknown keys silently ignored
                }
            }
        }
    }

    ;; ---- Node creation ----
    proc _make_node {kind parsed} {
        let id [get $parsed id]
        let flags [get $parsed flags]
        let body [get $parsed body]

        let node [lk::node $_tree $id $kind]

        ;; Append to current parent
        let stack_len [len $_parent_stack]
        if [> $stack_len 0] {
            let parent [get $_parent_stack [- $stack_len 1]]
            lk::append_child $_tree $parent $node
        }

        ;; Apply flags as props
        _apply_flags $node $flags

        ;; If body present, push this node as parent, eval body, pop
        if [not [empty? $body]] {
            set! _parent_stack [List::push $_parent_stack $node]
            eval $body
            set! _parent_stack [List::slice $_parent_stack 0 [- [len $_parent_stack] 1]]
        }

        return $node
    }

    ;; ---- Widget kind procs ----

    proc column {id *args} {
        _make_node column [_parse_flags $id $args]
    }

    proc row {id *args} {
        _make_node row [_parse_flags $id $args]
    }

    proc label {id *args} {
        _make_node label [_parse_flags $id $args]
    }

    proc button {id *args} {
        _make_node button [_parse_flags $id $args]
    }

    proc text_input {id *args} {
        _make_node text_input [_parse_flags $id $args]
    }

    proc spacer {id *args} {
        _make_node spacer [_parse_flags $id $args]
    }

    proc scroll {id *args} {
        _make_node scroll [_parse_flags $id $args]
    }

    ;; ---- Theme ----

    proc theme {body} {
        ;; Parse a rule inside theme body:
        ;; rule <kind> ?-tag <tag>? ?-state <state>? <style_dict>
        ;; kind "*" matches any
        proc rule {kind *args} {
            var tag {}
            var state {}
            var style_dict #{}
            var i 0
            let n [len $args]

            while [< $i $n] {
                let arg [get $args $i]

                if [== $arg -tag] {
                    set! tag [get $args [+ $i 1]]
                    set! i [+ $i 2]
                } else {
                    if [== $arg -state] {
                        set! state [get $args [+ $i 1]]
                        set! i [+ $i 2]
                    } else {
                        ;; Must be the style dict (last positional)
                        set! style_dict $arg
                        set! i [+ $i 1]
                    }
                }
            }

            lk::theme_rule $_ui $kind $tag $state $style_dict
        }

        eval $body
    }

    ;; ---- Translator ----
    ;; translator <event_type> <ptype> ?<kind_filter>? <cmd_name>
    proc translator {event_type ptype *rest} {
        if [== [len $rest] 1] {
            ;; 3-arg form: translator event ptype cmd
            lk::add_translator $_ui $event_type $ptype "" [get $rest 0]
        } else {
            ;; 4-arg form: translator event ptype kind cmd
            lk::add_translator $_ui $event_type $ptype [get $rest 0] [get $rest 1]
        }
    }

    ;; ---- Command handler ----
    ;; on <cmd_name> <handler_proc>
    proc on {cmd_name handler} {
        set! _cmd_handlers [put $_cmd_handlers $cmd_name $handler]
    }

    ;; ---- Event handler ----
    proc event_handler {callable} {
        lk::window_set_event_handler $_win $callable
    }

    ;; ---- View ----
    proc view {body} {
        set! _view_body $body
    }

    ;; ---- Internal: dispatch commands ----
    proc _dispatch_command {cmd} {
        let name [get $cmd name]
        if [has? $_cmd_handlers $name] {
            let handler [get $_cmd_handlers $name]
            $handler $cmd
        }
    }

    ;; ---- Internal: frame callback ----
    proc _frame {tree} {
        set! _tree $tree
        set! _parent_stack ()

        ;; Create implicit root window node
        let root [lk::node $_tree "root" "window"]
        lk::set_root $_tree $root
        set! _parent_stack [List::push $_parent_stack $root]

        ;; Eval the user's view body
        eval $_view_body

        set! _parent_stack ()
    }

    ;; ---- Top-level: app ----
    ;; app <title> ?-width N? ?-height N? ?-font path? ?-font_size N? { body }
    proc app {title *args} {
        ;; Parse app-level flags
        var width 800
        var height 600
        var font {}
        var font_size 16
        var body {}
        var i 0
        let n [len $args]

        while [< $i $n] {
            let arg [get $args $i]

            if [== $arg -width] {
                set! width [get $args [+ $i 1]]
                set! i [+ $i 2]
            } else {
                if [== $arg -height] {
                    set! height [get $args [+ $i 1]]
                    set! i [+ $i 2]
                } else {
                    if [== $arg -font] {
                        set! font [get $args [+ $i 1]]
                        set! i [+ $i 2]
                    } else {
                        if [== $arg -font_size] {
                            set! font_size [get $args [+ $i 1]]
                            set! i [+ $i 2]
                        } else {
                            ;; Last non-flag arg is the body
                            set! body $arg
                            set! i [+ $i 1]
                        }
                    }
                }
            }
        }

        ;; Create window and UI
        if [empty? $font] {
            set! _win [lk::window_create $title $width $height]
        } else {
            set! _win [lk::window_create $title $width $height $font $font_size]
        }
        set! _ui [lk::window_ui $_win]

        ;; Eval body — registers theme, translators, on-handlers, view, event_handler
        eval $body

        ;; Install command dispatcher if any on-handlers were registered
        if [not [empty? $_cmd_handlers]] {
            lk::set_command_handler $_ui [lambda {cmd} {
                _dispatch_command $cmd
            }]
        }

        ;; Run the window loop
        lk::window_run $_win [lambda {tree} { _frame $tree }]

        ;; Cleanup
        lk::window_destroy $_win
    }
}

;; Export all public DSL procs into caller's scope
import lk_dsl app
import lk_dsl view theme translator on event_handler
import lk_dsl column row label button text_input spacer scroll
